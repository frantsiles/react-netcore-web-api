# Copy this file to .env and fill in the values before running docker-compose.
# NEVER commit .env to version control.

# JWT shared secret (must be identical in Api + BFF; min 32 chars)
JWT_SECRET=CHANGE-THIS-SECRET-IN-PRODUCTION-MIN32CHARS!!

# PostgreSQL (local dev — puerto 5433 para no colisionar con instancias en 5432)
POSTGRES_DB=demodb
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo123

# RabbitMQ admin credentials
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# Grafana admin password
GRAFANA_ADMIN_PASS=admin
