{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "bff-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/{**catch-all}" }
      },
      "bff-parties-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/parties/{**catch-all}" }
      },
      "bff-catalog-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/catalog/{**catch-all}" }
      },
      "bff-sales-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/sales/{**catch-all}" }
      },
      "bff-purchasing-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/purchasing/{**catch-all}" }
      },
      "bff-inventory-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/inventory/{**catch-all}" }
      },
      "bff-accounting-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/accounting/{**catch-all}" }
      },
      "bff-banking-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/banking/{**catch-all}" }
      },
      "bff-tax-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/tax/{**catch-all}" }
      },
      "bff-approvals-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/approvals/{**catch-all}" }
      },
      "bff-hr-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/hr/{**catch-all}" }
      },
      "bff-reports-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/reports/{**catch-all}" }
      },
      "bff-invoicing-route": {
        "ClusterId": "bff-cluster",
        "Match": { "Path": "/bff/invoicing/{**catch-all}" }
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "bff-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/bff/health"
          }
        },
        "Destinations": {
          "bff": { "Address": "http://localhost:5001/" }
        }
      },
      "api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/health"
          }
        },
        "Destinations": {
          "api": { "Address": "http://localhost:5002/" }
        }
      }
    }
  }
}
